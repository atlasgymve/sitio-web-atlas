# Copia este archivo como ".env" (en la carpeta del proyecto) para trabajar en tu computadora.
# En Render, estas mismas variables se configuran en: tu servicio > Environment.
# El archivo .env está en .gitignore y NO se sube a GitHub.

# Base de datos
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=atlas
# DB_SSL=true   # para Aiven

# Clave para firmar las sesiones (texto largo y aleatorio)
SESSION_SECRET=

# Contraseñas del panel. Si se dejan vacías, no se modifican las cuentas existentes.
ADMIN_PASSWORD=
RECEPCION_PASSWORD=
